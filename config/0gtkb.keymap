#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E      &kp R  &kp T        &kp Y      &kp U  &kp I          &kp O       &kp P      &kp BSPC
&kp TAB    &kp A     &kp S     &kp D      &kp F  &kp G        &kp H      &kp J  &kp K          &kp L       &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V  &kp B        &kp N      &kp M  &kp SLASH      &kp RSHFT   &mo 2
&kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE         &lt 1 SPACE  &kp SPACE         &kp RIGHT_ALT  &kp K_MENU  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0      &kp MINUS  &kp EQUAL
&kp TAB    &none     &none     &none      &none   &none   &none      &none      &kp LBKT  &kp RBKT    &kp BSLH
&kp LSHFT  &none     &none     &none      &none   &none   &none      &kp COMMA  &kp DOT   &kp FSLH    &none
&kp LALT   &kp LALT  &kp LGUI  &kp SPACE          &none   &kp SPACE             &kp RALT  &kp C_MENU  &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&none  &none  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp STAR    &kp SLASH     &none  &none  &none  &none  &none
&none  &none  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS   &none         &none  &none  &none  &none
&none  &none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS    &none         &none  &none  &none  &none
&none  &none  &none            &kp KP_NUMBER_0                   &kp KP_DOT  &kp KP_ENTER         &none  &none  &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none      &none     &mkp LCLK       &msc SCRL_UP    &mkp RCLK        &none  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none      &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none
&none  &none  &none           &none           &none            &none      &none     &none           &none           &none            &none
&to 4  &none  &none           &mkp MB4                         &mkp MCLK  &mkp MB5                  &none           &none            &none
            >;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &none  &none  &none  &none  &none  &none  &bt BT_CLR
&none         &none         &none         &none           &none         &none  &none  &none  &none  &none  &none
&none         &none         &none         &none           &none         &none  &none  &none  &none  &none  &to 0
&none         &none         &none         &studio_unlock                &none  &none         &none  &none  &none
            >;
        };
    };
};
